    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:core": "node scripts/check-core-pure.mjs"
  },
  "dependencies": {
    "@immediately-run/sdk": "^0.25.0",
