  "//exports": "file-explorer-library Phase 03 / LIBRARY_MOUNTS_SPEC — this repo is ALSO a consumable library. SOURCE entries (no dist build): the immediately.run bundler transpiles the source at runtime via the git-mount, and a local consumer's bundler transpiles it too. '.' = the headless view + helpers (no SDK); './sdk' = the SDK adapter; './styles.css' = the stylesheet. The app entry (App.tsx) is unaffected.",
  "exports": {
    ".": "./src/lib-ui/index.ts",
    "./sdk": "./src/lib-ui/sdk/index.ts",
    "./styles.css": "./src/lib-ui/styles.css"
  },
  "peerDependencies": {
    "@immediately-run/sdk": "^0.25.0",
